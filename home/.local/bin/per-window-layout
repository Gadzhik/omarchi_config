#!/bin/bash
# Per-window keyboard layout for Hyprland.
# Hyprland keeps the xkb layout global; this daemon remembers which layout
# each window was last using and re-applies it when that window regains focus.
# Layout switching itself is still done by the normal grp: toggle key.

SOCK="${XDG_RUNTIME_DIR}/hypr/${HYPRLAND_INSTANCE_SIGNATURE}/.socket2.sock"

declare -A WIN_LAYOUT   # window address (or "layer:<ns>") -> layout index (0=us, 1=ru ...)
CUR_ADDR=""
LAYER_KEY=""            # set while a keyboard-grabbing layer surface holds focus

# Layer surfaces that take the keyboard. Hyprland sends no activewindowv2 for
# them, so without this they silently inherit the focused window's layout.
LAYER_GRABS_KEYBOARD='^(walker)$'

# Physical keyboards to drive (skip virtual / fcitx / power / video / hotkey devices).
mapfile -t KBDS < <(hyprctl devices -j | python3 -c '
import json,sys
skip=("virtual","fcitx","power","video","hotkey")
for k in json.load(sys.stdin)["keyboards"]:
    n=k["name"]
    if "keyboard" in n and not any(s in n for s in skip):
        print(n)
')
# Fallback: if nothing matched, drive every keyboard Hyprland reports.
if [[ ${#KBDS[@]} -eq 0 ]]; then
  mapfile -t KBDS < <(hyprctl devices -j | python3 -c 'import json,sys;[print(k["name"]) for k in json.load(sys.stdin)["keyboards"]]')
fi

# Set of keyboards we drive, for filtering activelayout events by device.
declare -A IS_OURS
for k in "${KBDS[@]}"; do IS_OURS[$k]=1; done

layout_index() { case "$1" in *Russian*) echo 1 ;; *) echo 0 ;; esac; }

apply_layout() {
  local idx="$1" k
  for k in "${KBDS[@]}"; do
    hyprctl switchxkblayout "$k" "$idx" >/dev/null 2>&1
  done
}

# Seed with the currently focused window.
CUR_ADDR="$(hyprctl activewindow -j | python3 -c 'import json,sys;print(json.load(sys.stdin).get("address","").removeprefix("0x"))' 2>/dev/null)"

socat -u UNIX-CONNECT:"$SOCK" - 2>/dev/null | while IFS= read -r line; do
  ev="${line%%>>*}"; data="${line#*>>}"
  case "$ev" in
    activewindowv2)
      CUR_ADDR="${data#0x}"
      apply_layout "${WIN_LAYOUT[$CUR_ADDR]:-0}"
      ;;
    openlayer)
      # A launcher opened on top of the focused window: give it its own layout
      # slot instead of letting it inherit (and later overwrite) the window's.
      if [[ $data =~ $LAYER_GRABS_KEYBOARD ]]; then
        LAYER_KEY="layer:$data"
        apply_layout "${WIN_LAYOUT[$LAYER_KEY]:-0}"
      fi
      ;;
    closelayer)
      if [[ -n $LAYER_KEY && $LAYER_KEY == "layer:$data" ]]; then
        LAYER_KEY=""
        apply_layout "${WIN_LAYOUT[$CUR_ADDR]:-0}"
      fi
      ;;
    activelayout)
      # data is "KEYBOARDNAME,Layout Name"; store it for whatever holds the
      # keyboard right now — the layer surface if one is up, else the window.
      # Only our physical keyboards count: fcitx5's virtual keyboard re-announces
      # its own (always us) layout on every focus change, which would otherwise
      # wipe the layout we just remembered for the window.
      if [[ -n ${IS_OURS[${data%%,*}]} ]]; then
        key="${LAYER_KEY:-$CUR_ADDR}"
        [[ -n $key ]] && WIN_LAYOUT[$key]="$(layout_index "${data#*,}")"
      fi
      ;;
    closewindow)
      unset 'WIN_LAYOUT[${data#0x}]'
      ;;
  esac
done
