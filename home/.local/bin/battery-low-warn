#!/bin/bash
# Warn when the battery gets low, and shut the machine down cleanly if it gets
# critical while nobody is around to plug it in.
#
# Two thresholds:
#   below LOW (20%)      — a big window, closes on any key or after HOLD seconds
#   below CRITICAL (10%) — a big window with a live countdown, then poweroff
#
# An uncontrolled power loss on LUKS+btrfs is worse than a clean shutdown, which
# is the point of the second one. It is abortable two ways: plug in the charger,
# or press a key. Both are checked every second during the countdown.
#
# Mako notifications are too easy to overlook for something that ends in a dead
# machine, so these are real windows — floating, centred and pinned by the rules
# in ~/.config/hypr/looknfeel.conf. Alacritty is already the default terminal
# here, so nothing extra gets installed.
#
# Each warning fires once per discharge episode and re-arms only after the
# battery is back above its CLEAR level, so it never nags around the threshold.
#
# Launched from Hyprland autostart.

# Overridable from the environment so the thing can actually be tested:
#   LOW=100 LOW_CLEAR=101 HOLD=10 POLL=5 battery-low-warn
BAT=${BAT:-/sys/class/power_supply/BAT0}
AC=${AC:-/sys/class/power_supply/ADP1/online}
LOW=${LOW:-20}                      # percent — first warning below this
LOW_CLEAR=${LOW_CLEAR:-25}          # percent — re-arm the first warning above this
CRITICAL=${CRITICAL:-10}            # percent — countdown to poweroff below this
CRIT_CLEAR=${CRIT_CLEAR:-15}        # percent — re-arm the countdown above this
HOLD=${HOLD:-60}                    # seconds the first window stays up
COUNTDOWN=${COUNTDOWN:-60}          # seconds before poweroff
POLL=${POLL:-30}                    # seconds between checks

on_ac() { [[ "$(cat "$AC" 2>/dev/null)" == "1" ]]; }

# ---------------------------------------------------------------------------
# Window bodies. Re-invoked through "$0" inside Alacritty so the text can use
# quotes freely instead of being smuggled through `sh -c`.
# ---------------------------------------------------------------------------
render_low() {
  local cap=$1
  printf '\n\n'
  printf '  \033[1;33m▲  БАТАРЕЯ %s%%\033[0m\n\n' "$cap"
  printf '  \033[1mОсталось меньше %s%%.\033[0m\n\n' "$LOW"
  printf '  Подключи зарядку, иначе ноутбук\n'
  printf '  уснёт и сеанс прервётся.\n\n\n'
  printf '  \033[2mлюбая клавиша — закрыть · авто через %s с\033[0m\n' "$HOLD"
  read -r -t "$HOLD" -n 1 _
}

render_critical() {
  local cap=$1 left=$COUNTDOWN key
  while [[ $left -gt 0 ]]; do
    # Redraw in place so the countdown ticks visibly.
    printf '\033[H\033[2J'
    printf '\n\n'
    printf '  \033[1;31m■  БАТАРЕЯ %s%% — КРИТИЧЕСКИЙ ЗАРЯД\033[0m\n\n' "$cap"
    printf '  \033[1;31mВыключение через %s с.\033[0m\n\n' "$left"
    printf '  Подключи зарядку — отменится само.\n\n\n'
    printf '  \033[2mлюбая клавиша — отменить выключение\033[0m\n'

    if on_ac; then
      printf '\n  \033[1;32m✓ Зарядка подключена — отменено.\033[0m\n'
      sleep 3
      return 0
    fi
    if read -r -t 1 -n 1 key; then
      printf '\n  \033[1;32m✓ Отменено вручную.\033[0m\n'
      sleep 2
      return 0
    fi
    left=$((left - 1))
  done

  # Last look before doing something irreversible.
  if on_ac; then
    printf '\n  \033[1;32m✓ Зарядка подключена — отменено.\033[0m\n'
    sleep 3
    return 0
  fi
  printf '\n  \033[1;31mВыключаюсь…\033[0m\n'
  systemctl poweroff
}

case "${1:-}" in
  __low)      render_low "$2";      exit 0 ;;
  __critical) render_critical "$2"; exit 0 ;;
esac

show() {
  local mode=$1 cap=$2
  alacritty --class battery-warning -o font.size=26 -e "$0" "$mode" "$cap" \
    >/dev/null 2>&1 &
}

# ---------------------------------------------------------------------------
warned_low=0
warned_crit=0

while :; do
  cap=$(cat "$BAT/capacity" 2>/dev/null)
  status=$(cat "$BAT/status" 2>/dev/null)

  if [[ -n "$cap" ]]; then
    if [[ "$status" == "Discharging" ]]; then
      # Critical first: below it the low warning is redundant noise.
      if [[ "$cap" -lt "$CRITICAL" && "$warned_crit" -eq 0 ]]; then
        show __critical "$cap"
        warned_crit=1
        warned_low=1
      elif [[ "$cap" -lt "$LOW" && "$warned_low" -eq 0 ]]; then
        show __low "$cap"
        warned_low=1
      fi
    fi

    # Re-arm once charging again or comfortably above each threshold.
    if [[ "$status" != "Discharging" || "$cap" -ge "$LOW_CLEAR" ]]; then
      warned_low=0
    fi
    if [[ "$status" != "Discharging" || "$cap" -ge "$CRIT_CLEAR" ]]; then
      warned_crit=0
    fi
  fi

  sleep "$POLL"
done
