#!/bin/bash
# Adjust the system for AC vs battery power.
#   On AC      -> 165Hz, balanced profile, restore saved brightness
#   On battery -> 60Hz,  power-saver profile, dim brightness
# Launched from Hyprland autostart; reacts to power_supply udev events.

MONITOR=eDP-1
RES=3072x1920
SCALE=1.6
AC=/sys/class/power_supply/ADP1/online
AC_RATE=165
BAT_RATE=60
BAT_BRIGHTNESS=15    # percent while on battery

# The power state is per-boot on purpose: a fresh login must re-apply, not
# inherit. The AC brightness is the opposite — it has to outlive a reboot, or
# the first battery boot records the already-dimmed screen as the AC value and
# the AC brightness ratchets down to BAT_BRIGHTNESS and stays there.
STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/power-mode.state"
SAVED_BRIGHTNESS="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/power-mode.brightness"
AC_BRIGHTNESS_FALLBACK=40

on_ac() { [[ "$(cat "$AC" 2>/dev/null)" == "1" ]]; }

# Battery-runtime log, read back with `journalctl --user -t power-mode`.
# UPower keeps only about a week of history; the journal keeps months.
# A session opens when the machine goes on battery and is summarised when AC
# returns. It lives in XDG_STATE_HOME so a battery stretch survives a reboot.
# Duration is wall-clock time, so suspend inside a session is counted too.
BAT=/sys/class/power_supply/BAT0
SESSION="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/power-mode.session"

log() { logger -t power-mode -- "$*"; }

bat_energy() { cat "$BAT/energy_now" 2>/dev/null; }    # µWh
bat_pct() { cat "$BAT/capacity" 2>/dev/null; }

session_open() {
  local t e p
  t=$(date +%s) e=$(bat_energy) p=$(bat_pct)
  # A session left open by a shutdown on battery carries on after the reboot,
  # unless the battery gained charge meanwhile (charged while off).
  if [[ -s $SESSION ]]; then
    local _ e0 _
    read -r _ e0 _ <"$SESSION"
    if [[ -n $e && -n $e0 ]] && (( e <= e0 )); then
      log "battery: ${p}% (session from before reboot continues)"
      return
    fi
  fi
  mkdir -p "$(dirname "$SESSION")"
  echo "$t $e $p" >"$SESSION"
  log "battery: ${p}%, $(awk -v e="$e" 'BEGIN { printf "%.1f", e / 1e6 }') Wh"
}

session_close() {
  local t e p
  t=$(date +%s) e=$(bat_energy) p=$(bat_pct)
  if [[ ! -s $SESSION ]]; then
    log "ac: ${p}%"
    return
  fi
  local t0 e0 p0
  read -r t0 e0 p0 <"$SESSION"
  rm -f "$SESSION"
  if [[ -z $e || -z $e0 ]] || (( e > e0 )); then
    # Charged while powered off: the energy delta means nothing.
    log "ac: ${p}% (battery session since $(date -d "@$t0" '+%F %R'), consumption unknown)"
    return
  fi
  log "$(awk -v dt=$((t - t0)) -v de=$((e0 - e)) -v p0="$p0" -v p="$p" 'BEGIN {
    h = dt / 3600; wh = de / 1e6
    printf "ac: on battery %.2f h, %d%% -> %d%%, used %.1f Wh, avg %.1f W",
      h, p0, p, wh, (h > 0 ? wh / h : 0)
  }')"
}

# Hyprland 0.56 refuses `hyprctl keyword` under a Lua config ("keyword can't
# work with non-legacy parsers. Use eval."), so the monitor mode is now set by
# evaluating the same hl.monitor() call the config uses.
set_refresh() {
  hyprctl eval \
    "hl.monitor({ output = \"$MONITOR\", mode = \"$RES@$1\", position = \"auto\", scale = $SCALE })" \
    >/dev/null 2>&1
}

# apply [initial]
#   "initial" marks the launch-time call, where no AC->battery transition
#   actually happened: the brightness on screen is whatever systemd-backlight
#   restored at boot, so it says nothing about the preferred AC brightness and
#   must not be recorded as one.
apply() {
  local initial="${1:-}"
  local now prev=""
  if on_ac; then now=ac; else now=battery; fi
  [[ -f "$STATE_FILE" ]] && prev="$(cat "$STATE_FILE")"
  [[ "$now" == "$prev" ]] && return    # only act on real transitions
  echo "$now" >"$STATE_FILE"

  if [[ "$now" == "battery" ]]; then
    session_open
    # Remember the current brightness so AC can restore it — but only when it
    # is actually brighter than the battery target. On a battery boot the screen
    # already comes up dimmed (systemd-backlight restores the last value), and
    # recording that would overwrite a good AC brightness with the dim one.
    local cur
    cur="$(brightnessctl -m | cut -d, -f4 | tr -d '%')"
    if [[ $initial != initial && -n $cur ]] && (( cur > BAT_BRIGHTNESS )); then
      mkdir -p "$(dirname "$SAVED_BRIGHTNESS")"
      echo "$cur" >"$SAVED_BRIGHTNESS"
    fi

    set_refresh "$BAT_RATE"
    powerprofilesctl set power-saver 2>/dev/null
    brightnessctl set "${BAT_BRIGHTNESS}%" >/dev/null 2>&1
  else
    session_close
    set_refresh "$AC_RATE"
    powerprofilesctl set balanced 2>/dev/null
    local restore="$AC_BRIGHTNESS_FALLBACK"
    [[ -s "$SAVED_BRIGHTNESS" ]] && restore="$(cat "$SAVED_BRIGHTNESS")"
    brightnessctl set "${restore}%" >/dev/null 2>&1
  fi

  # Omarchy 4's idle service has no notion of the power source, so the
  # battery-only idle policy has to be re-applied on every transition.
  # See ~/.local/bin/battery-idle.
  "$(dirname "$0")/battery-idle" apply 2>/dev/null
}

# Stored state may be stale after a reboot, so force a fresh apply on launch.
rm -f "$STATE_FILE"
apply initial

# React to every AC adapter / battery change reported by udev.
stdbuf -oL udevadm monitor --udev --subsystem-match=power_supply 2>/dev/null | while read -r _; do
  apply
done
