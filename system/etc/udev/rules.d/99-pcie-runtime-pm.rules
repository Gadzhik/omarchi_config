# Runtime PM для PCI: разрешить устройствам засыпать между обращениями.
#
# Ядро оставляет power/control=on у всех устройств, чей драйвер не включает
# runtime PM сам. На Meteor Lake так и остаются оба NVMe, CNVi Wi-Fi, ISH, GNA,
# eSPI/SPI и shared SRAM — powertop показывает их в Tunables как "Bad", а в
# Device stats как 100% занятости (это не нагрузка, а «ни разу не заснул»).
#
# "auto" не усыпляет устройство принудительно — оно отдаёт решение драйверу:
# уход в D3 при простое, пробуждение по первому обращению.
#
# Замерено 2026-08-04, powertop --time=60 в простое: 7.05 -> 6.73 Вт.
# Основной вклад даёт ASPM (см. tmpfiles.d/99-pcie-aspm.conf), а не это правило:
# из 11 переключённых устройств реально засыпают только 00:08.0 и 00:1f.0.
# Остальные держит драйвер — i915 при включённом экране, iwlwifi при активном
# соединении (это правильно), а igen6_edac, proc_thermal_pci, intel_vsec,
# intel_ish_ipc, intel_pmc_ssram_telemetry и intel-spi runtime suspend просто
# не реализуют. Правило им не вредит, поэтому оставлено общим на подсистему.
#
# ОБА NVMe остаются active навсегда (runtime_suspended_time = 0), хотя стоят на
# "auto". Так и должно быть: драйвер nvme держит ссылку runtime PM, пока у
# контроллера есть живые namespace, а они смонтированы. Питанием NVMe в простое
# управляет APST внутри самого диска, а не PCI runtime PM. У YMTC он работает
# (pm_qos_latency_tolerance_us = 100000), а системный Netac его не поддерживает
# вовсе — проверено 2026-08-04:
#   sudo nvme get-feature /dev/nvme1 -f 0x0c -H
#   NVMe status: Invalid Field in Command (0x2)
# Контроллер не знает feature 0x0c, то есть это не выключенная настройка, а
# отсутствующая возможность. Системный диск постоянно в полном питании, и это,
# вероятно, крупнейшая из оставшихся статей расхода. Конфигом не лечится.
#
# Откат:
#   sudo rm /etc/udev/rules.d/99-pcie-runtime-pm.rules && sudo reboot
#
# Если DRAM-less Netac начнёт отваливаться под нагрузкой (в dmesg — таймауты
# nvme), исключить конкретно его по PCI-адресу, не откатывая всё правило:
# дописать в строку ниже KERNEL!="0000:01:00.0" (адрес — из lspci).

# add|change, а не просто add: устройства, существующие на момент загрузки,
# событие add получают только при холодном старте, а `udevadm trigger` по
# умолчанию шлёт change. С одним add правило молча не применяется до перезагрузки.
ACTION=="add|change", SUBSYSTEM=="pci", TEST=="power/control", ATTR{power/control}="auto"
